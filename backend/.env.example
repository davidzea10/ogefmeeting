NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# En production (Render) : URL(s) COMPLÈTE(S) avec https://, séparées par des virgules
# Exemple :
# CORS_ORIGIN=https://ogefmeeting-frontend.vercel.app,http://localhost:5173
# Les previews Vercel (…-git-main-….vercel.app) sont aussi acceptées si une URL *.vercel.app est listée.
# (sans slash final)

# Supabase — URL du projet SANS /rest/v1/
# Exemple correct : https://xxxx.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Auth JWT — false = jamais bloquant (recommandé pour déploiement / démo)
# true = requireAuth, requireRoles et requirePermission refusent les requêtes sans token / droits
AUTH_ENFORCED=false

# =============================================================================
# Emails — Resend (OBLIGATOIRE pour inviter des participants)
# =============================================================================
# Sans RESEND_API_KEY, la création/édition avec nouveaux invités est refusée.
#
# Étapes :
# 1. Compte sur https://resend.com
# 2. API Keys → Create API Key → coller ci-dessous
# 3. Expéditeur (EMAIL_FROM) :
#    - Test rapide : Ogefmeeting <onboarding@resend.dev>
#      → Resend n’envoie qu’à l’email de VOTRE compte Resend
#    - Prod : Domains → Add Domain (ex. ogefrem.cd) → DNS SPF/DKIM
#      → EMAIL_FROM=Ogefmeeting <noreply@ogefrem.cd>
#    IMPORTANT : vous ne pouvez PAS utiliser un Gmail/Yahoo comme « From »
#    sans domaine vérifié. Votre adresse perso sert surtout de destinataire de test.
# 4. Local : ce fichier .env + redémarrer npm run dev
# 5. Render : Environment → RESEND_API_KEY + EMAIL_FROM + FRONTEND_URL → Redeploy
#
RESEND_API_KEY=
EMAIL_FROM=Ogefmeeting <onboarding@resend.dev>
# Prod (domaine vérifié) :
# EMAIL_FROM=Ogefmeeting <noreply@votredomaine.com>

# =============================================================================
# Deepgram — transcription live (STT streaming)
# =============================================================================
# Console : https://console.deepgram.com → API Keys
# Ne jamais exposer cette clé au frontend.
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=fr
DEEPGRAM_MODEL=nova-3

# =============================================================================
# OpenAI — génération compte rendu (après réunion)
# =============================================================================
# Platform : https://platform.openai.com/api-keys
# Ne jamais exposer cette clé au frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
