# Copier vers .env et remplir (ne jamais committer .env)

# Deepgram — transcription temps réel (STT live)
DEEPGRAM_API_KEY=

# Langue principale du projet
DEEPGRAM_LANGUAGE=fr

# Modèle recommandé pour réunions
DEEPGRAM_MODEL=nova-3

# OpenAI — génération compte rendu (après réunion)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
